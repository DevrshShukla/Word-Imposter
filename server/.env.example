# ==========================================
# Word Imposter - Backend Server Environment
# ==========================================

# Server Port (Render automatically supplies PORT)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection URI:
# - In production: MANDATORY (MongoDB Atlas)
# - In development/test: Optional (omitting will automatically start an in-memory MongoDB)
MONGODB_URI=

# Session Secret (MANDATORY custom key in production)
SESSION_SECRET=word-imposter-super-secret-key-change-in-prod-2026

# Allowed Client Origin(s) for CORS (comma-separated or * in dev)
CLIENT_ORIGIN=http://localhost:5173

# Optional dataset CSV path
DATASET_PATH=

# ==========================================
# Word Imposter - Unified Environment Config
# ==========================================

# Server Port (Render sets this automatically)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection URI (MANDATORY in production)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/word_imposter?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://app_user:YourStrongPasswordHere@cluster0.mongodb.net/word_imposter?retryWrites=true&w=majority

# Strong secret key for signing player session JWT tokens (MANDATORY in production)
# Generate a strong 64-char key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_cryptographically_secure_random_string_in_production

# Allowed client origins for CORS (Optional in unified mode, or comma-separated URLs if frontend is hosted separately)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Path to word pair CSV dataset (defaults to auto-detection)
DATASET_PATH=

# ==========================================
# Word Imposter - Frontend Client Environment
# ==========================================

# Base API URL:
# - In Unified deployment (Express serving Vite SPA): leave empty or use /api/v1
# - In Separate frontend deployment: set to backend full URL (e.g. https://word-imposter-api.onrender.com/api/v1)
VITE_API_BASE_URL=/api/v1

# Socket.IO Server URL:
# - In Unified deployment: leave empty (defaults to window.location.origin)
# - In Separate frontend deployment: set to backend origin (e.g. https://word-imposter-api.onrender.com)
VITE_SOCKET_URL=
